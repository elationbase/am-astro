---
import Tag from "../components/Tag.astro";
import HeroPath from "./HeroPath.astro";
import HeroType from "./HeroType.astro";
---

<section class="hero-section grid overflow-hidden h-[75vh] w-full mt-8 bg-dark">
  <HeroPath />
  <HeroType />
  <img
    src="/img/am-desk.jpg"
    alt="Hero Image"
    class="w-full animate-fade-in-slow col-start-1 row-start-1 opacity-0"
  />
  <div
    class="bg-linear-to-b from-transparent via-transparent to-black col-start-1 row-start-1 h-full w-full"
  >
  </div>

  <div class="col-start-1 row-start-1 w-full grid place-items-center">
    <Tag />
  </div>
</section>

<style>
  .hero-section {
    animation: heroExitImg linear;
    animation-timeline: view();
    animation-range: exit;
  }
  @keyframes heroExitImg {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.5);
    }
  }

  @keyframes fadeInHero {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100px);
    }
  }

  .animate-fade-in-slow {
    animation: fadeIn 3s ease-out forwards;
    animation-delay: 5s;
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
</style>

<style>
  .hero-svg path,
  .hero-svg ellipse {
    stroke-dasharray: 2200;
    stroke-dashoffset: 2200;
    animation-name: draw;
    animation-fill-mode: forwards;
    fill: none;
    stroke: #ffffff;
    stroke-width: 1px;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    stroke-opacity: 1;
  }
  #monitor path {
    animation-delay: 0s;
    animation-duration: 4s;
  }
  #speakers path {
    animation-delay: 1s;
    animation-duration: 4s;
  }
  #photo path {
    animation-delay: 1.5s;
    animation-duration: 4s;
  }
  #photo path {
    animation-delay: 1.5s;
    animation-duration: 3s;
  }
  #notes path {
    animation-delay: 2s;
    animation-duration: 4s;
  }
  #coffee path {
    animation-delay: 3s;
    animation-duration: 3s;
  }
  #mat path {
    animation-delay: 3s;
    animation-duration: 2s;
  }
  #synths path,
  #synths ellipse {
    animation-delay: 4s;
    animation-duration: 4s;
  }
  #ipad path {
    animation-delay: 4.5s;
    animation-duration: 3s;
  }
  #headphones path {
    animation-delay: 5s;
    animation-duration: 3s;
  }
  #earbuds path {
    animation-delay: 5.5s;
    animation-duration: 4s;
  }
  #keyboard path {
    animation-delay: 1s;
    animation-duration: 3s;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

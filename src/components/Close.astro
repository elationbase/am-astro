---
type Props = {
  onClick?: string;
};

const { onClick = "history.back(); return false;" } = Astro.props;
---

<a href="/" onclick={onClick} class="icon-close">CLOSE</a>
<style>
  .icon-close {
    height: 50px;
    width: 50px;
    position: fixed;
    z-index: 120;
    right: 25px;
    top: 12.5px;
    box-sizing: border-box;
    line-height: 50px;
    display: inline-block;
    text-indent: -9999px;
  }
  .icon-close:after, .icon-close:before {
    transform: rotate(-45deg);
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -1px;
    margin-left: -25px;
    display: block;
    height: 2px;
    width: 50px;
    background-color: #fff;
    box-shadow: 0 0 15px rgba(0, 0, 0, .5);
    transition: all .25s ease-out;
}
.icon-close:after {
    transform: rotate(-135deg);
}
.icon-close:hover:after, .icon-close:hover:before {
    transform: rotate(0deg);
}
</style>

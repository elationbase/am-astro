---

<header
  class="fixed top-4 right-4 left-4 rounded-full z-50 flex justify-between items-center px-4 py-2 backdrop-blur-2xl bg-dark/10 gap-8"
>
  <div class="flex gap-2 items-center justify-start">
    <img
      class="max-h-7"
      src="/img/am.svg"
      alt="Alvaro Montero Logo"
      width="63"
      height="28"
    />
    <h1 class="font-mono text-xs text-white uppercase">
      alvaro<span class="text-white/70">.montero</span>
    </h1>
  </div>
  <nav class="flex gap-1">
    {
      links.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Go to ${item.label}`}
          class="text-white transition-colors backdrop-blur-2xl p-1 md:p-3 rounded-full hover:bg-blue/20"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d={item.path} />
          </svg>
        </a>
      ))
    }
  </nav>
</header>

---
/**
 * Typewriter.astro — Standalone terminal-style typewriter component.
 *
 * Drop into any Astro project (no dependencies). Cycles through `lines`, typing
 * each one character-by-character then erasing, with a blinking caret.
 *
 * Usage:
 *   import Typewriter from "../components/Typewriter.astro";
 *
 *   <!-- Single static line -->
 *   <Typewriter lines={["Hi there!!!"]} />
 *
 *   <!-- Rotating multi-line terminal -->
 *   <Typewriter
 *     lines={[
 *       "role: Creative Technologist",
 *       "based: Miami, FL",
 *       "status: open to projects",
 *     ]}
 *     prompt=">"
 *     color="#5ee0d6"
 *     typeSpeed={55}
 *     holdMs={1800}
 *     eraseSpeed={22}
 *   />
 *
 *   <!-- Without prompt, no looping -->
 *   <Typewriter lines={["Welcome."]} prompt="" loop={false} />
 */

type Props = {
  /** Lines to cycle through. */
  lines: string[];
  /** Prefix shown before the text (e.g. ">", "$", "❯"). Pass "" to hide. */
  prompt?: string;
  /** Milliseconds per typed character. */
  typeSpeed?: number;
  /** Milliseconds to hold a fully-typed line before erasing. */
  holdMs?: number;
  /** Milliseconds per erased character. */
  eraseSpeed?: number;
  /** Re-cycle after the last line. Set false to type once and stop on last line. */
  loop?: boolean;
  /** Caret + text color (CSS color value). */
  color?: string;
  /** Font family (defaults to a monospace stack). */
  fontFamily?: string;
  /** Font size (any CSS value). */
  fontSize?: string;
  /** Extra class(es) on the wrapper. */
  class?: string;
}

const {
  lines,
  prompt = ">",
  typeSpeed = 55,
  holdMs = 1800,
  eraseSpeed = 22,
  loop = true,
} = Astro.props;

const config = { lines, typeSpeed, holdMs, eraseSpeed, loop };
---

<span
  class=
    "js-typewriter inline-flex items-baseline gap-2"
  data-config={JSON.stringify(config)}
  role="status"
  aria-live="polite"
>
  {prompt && <span class="opacity-60">{prompt}</span>}
  <span class="tw-text whitespace-pre"></span>
  <span
    class="inline-block w-2 h-4 bg-current animate-tw-blink motion-reduce:animate-none motion-reduce:opacity-70"
    aria-hidden="true"
  ></span>
</span>

<script>
  type TWConfig = {
    lines: string[];
    typeSpeed: number;
    holdMs: number;
    eraseSpeed: number;
    loop: boolean;
  };

  function initTypewriter(root: HTMLElement) {
    const textEl = root.querySelector<HTMLElement>(".tw-text");
    if (!textEl) return;
    let config: TWConfig;
    try {
      config = JSON.parse(root.dataset.config || "{}");
    } catch {
      return;
    }
    const { lines, typeSpeed, holdMs, eraseSpeed, loop } = config;
    if (!lines || lines.length === 0) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // For reduced motion, just show the first line immediately and stop.
    if (reduceMotion) {
      textEl.textContent = lines[0];
      return;
    }

    let lineIdx = 0;
    let i = 0;
    let phase: "typing" | "holding" | "erasing" = "typing";
    let timer: number | undefined;

    const tick = () => {
      const current = lines[lineIdx % lines.length];
      const isLast = lineIdx >= lines.length - 1;

      if (phase === "typing") {
        textEl.textContent = current.slice(0, i);
        i++;
        if (i > current.length) {
          // Holding before erase. If only one line and not looping, stop here.
          if (lines.length === 1 && !loop) return;
          if (isLast && !loop) return;
          phase = "holding";
          timer = window.setTimeout(tick, holdMs);
        } else {
          timer = window.setTimeout(tick, typeSpeed);
        }
        return;
      }

      if (phase === "holding") {
        phase = "erasing";
        i = current.length;
        timer = window.setTimeout(tick, eraseSpeed);
        return;
      }

      if (phase === "erasing") {
        i--;
        textEl.textContent = current.slice(0, Math.max(0, i));
        if (i <= 0) {
          lineIdx = (lineIdx + 1) % lines.length;
          phase = "typing";
          i = 0;
          timer = window.setTimeout(tick, typeSpeed);
        } else {
          timer = window.setTimeout(tick, eraseSpeed);
        }
      }
    };

    tick();

    // Optional: pause when offscreen for battery friendliness.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting && timer !== undefined) {
          clearTimeout(timer);
          timer = undefined;
        } else if (e.isIntersecting && timer === undefined) {
          tick();
        }
      }
    });
    io.observe(root);
  }

    function setup() {
    document.querySelectorAll<HTMLElement>(".js-typewriter").forEach(initTypewriter);
  }
  setup();
  // Re-init after Astro View Transitions navigate to a new page.
  document.addEventListener("astro:page-load", setup);
</script>

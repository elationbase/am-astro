---
import { Picture } from "astro:assets";
import { DATA, type ProjectType } from "@/data";

const projects: ProjectType[] = DATA.projects;
---

<section class="py-16 md:py-20 bg-darker" id="projects">
  <div class="px-4 sm:px-8 mx-auto max-w-450">
    <nav aria-label="Projects navigation">
      <h1 class="text-3xl md:text-4xl lg:text-5xl text-light font-extralight">
        Projects<span>.</span>
      </h1>
      <h2
        class="text-blue font-black uppercase relative text-xs pb-2 font-mono"
      >
        Chapter 03 | ~ 2026
      </h2>

    <hr class="my-10 border border-light/20" />
      <ul
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 list-none"
      >
        {
          projects.map(
            ({ name, important, pictureHome, company, projectTitle }) => (
              <li class="mb-4 break-inside-avoid fade-in p-4 bg-dark rounded-lg shadow-md hover:shadow-2xl">
                <a
                  href={`/project/${name}`}
                  class:list={[
                    "project-link rounded-md shadow-sm relative overflow-hidden group block",
                    important ? "h-140" : "h-70",
                  ]}
                >
                  <Picture
                    src={pictureHome}
                    alt={`${company} — ${projectTitle}`}
                    widths={[400, 800]}
                    sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    formats={["avif", "webp"]}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 w-full h-full object-cover transition-all duration-500 group-hover:scale-110 group-hover:blur-sm"
                    transition:name={`bg-${name}`}
                  />
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-center p-6 bg-dark/70">
                    <h3
                      class="text-2xl mb-2 text-light font-light group-hover:scale-100 scale-150 origin-left group-hover:blur-none blur-sm transition-all delay-150 ease-in-out duration-500"
                      transition:name={`company-${name}`}
                    >
                      {company}
                    </h3>
                    <p
                      class="text-lg text-salmon group-hover:translate-y-0 translate-y-56 group-hover:opacity-100 opacity-0 transition-all ease-out duration-500 delay-500"
                      transition:name={`title-${name}`}
                    >
                      {projectTitle}
                    </p>
                  </div>
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</section>

<style>
  .fade-in {
    opacity: 0;
    animation: fade-in linear forwards;
    animation-timeline: view();
    animation-range: entry 0% entry 100%;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @supports not (animation-timeline: view()) {
    .fade-in {
      opacity: 1;
      animation: fade-in-fallback 0.6s ease-out forwards;
    }

    @keyframes fade-in-fallback {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark py-12 px-4 md:px-12 lg:px-24">
  <img
    class="w-40 mb-4"
    src="/img/am.svg"
    alt="Alvaro Montero Logo"
    width="310"
    height="142"
  />
  <div class="mb-4 text-white/40">
    <p>
      Designed and Coded with <span class="text-salmon">❤</span> by <span
        class="text-salmon">Alvaro Montero</span
      > Feb. 2026.
    </p>
    <p>
      The repo for this webapp can be found <a
        class="text-salmon hover:text-salmon/70"
        href="https://github.com/elationbase/am-astro">@github.com</a>
    </p>
  </div>
  <div class="mb-4 text-white/40">
    <p>
      Source Technology used: Figma + SVG + HTML + Tailwind + JS + Astro JS +
      GitHub.
    </p>
    <p>Stock Photography courtesy of https://picjumbo.com</p>
  </div>
  <p class="mt-4 text-white font-light">
    © {currentYear} Montero Design. All rights reserved.
  </p>
</footer>

---
const stack = {
  headline: "Typical technology stack",
  dependencies: [
    { name: "@apollo/client", version: "3.11.0" },
    { name: "@sentry/nextjs", version: "8.45.0" },
    { name: "astro", version: "5.1.0" },
    { name: "firebase", version: "11.1.0" },
    { name: "graphql", version: "16.10.0" },
    { name: "next", version: "16.2.3" },
    { name: "prisma", version: "7.8.0" },
    { name: "react", version: "19.0.0" },
    { name: "react-native", version: "0.76.0" },
    { name: "tailwindcss", version: "4.0.0" },
    { name: "vue", version: "3.5.0" },
    { name: "zod", version: "3.24.0" },
  ],
  devDependencies: [
    { name: "@commitlint/cli", version: "^20.5.0" },
    { name: "@testing-library/react", version: "^16.3.2" },
    { name: "@types/react", version: "^19.0.0" },
    { name: "cypress", version: "^14.0.0" },
    { name: "eslint", version: "^9.0.0" },
    { name: "husky", version: "^9.1.7" },
    { name: "jest", version: "^30.3.0" },
    { name: "playwright", version: "^1.49.0" },
    { name: "prettier", version: "^3.8.3" },
    { name: "storybook", version: "^8.4.0" },
    { name: "typescript", version: "^6.0.3" },
    { name: "vercel", version: "^52.0.0" },
  ],
};
---

<section class="py-16 md:py-20 bg-darker">
  <div class="container mx-auto px-4 sm:px-8 max-w-6xl">
    <h1 class="text-3xl md:text-4xl lg:text-5xl text-light font-extralight">
      {stack.headline}<span>.</span>
    </h1>
    <h2 class="text-blue font-black uppercase relative text-xs pb-2 font-mono">
      Chapter 05 | package.me
    </h2>
    <hr class="my-10 border border-b-light/20" />
    <div class="border border-light/20 rounded-lg bg-black/40">
      <div class="flex gap-2 p-3 items-center border border-b-light/20">
        <span class="rounded-full w-3 h-3 bg-[#ff5f57]"></span>
        <span class="rounded-full w-3 h-3 bg-[#febc2e]"></span>
        <span class="rounded-full w-3 h-3 bg-[#28c840]"></span>
        <p class="text-sm text-light/40 font-mono pl-4">
          ~ / portfolio / package.json
        </p>
      </div>
      <div
        class="bg-black/20 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2 p-4 font-mono text-light/70 rounded-b-lg text-sm"
      >
        <div>
          <p class="text-blue mb-1">"dependencies": &#123;</p>
          {
            stack.dependencies.map(({ name, version }) => (
              <p class="pl-4">
                <span class="text-salmon">"{name}"</span>:{" "}
                <span class="text-light">"{version}"</span>,
              </p>
            ))
          }
          <p>&#125;,</p>
        </div>
        <div>
          <p class="text-blue mb-1">"devDependencies": &#123;</p>
          {
            stack.devDependencies.map(({ name, version }) => (
              <p class="pl-4">
                <span class="text-salmon">"{name}"</span>:{" "}
                <span class="text-light">"{version}"</span>,
              </p>
            ))
          }
          <p>&#125;</p>
        </div>
      </div>
    </div>
  </div>
</section>
